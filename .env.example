# Copy this file to ".env" (same folder) and put your Anthropic API key below.
# Get a key at https://console.anthropic.com  ->  API Keys.
# The .env file stays on your PC; it is never uploaded to GitHub (it's in .gitignore).
ANTHROPIC_API_KEY=sk-ant-...

